<Page x:Class="StylishkidsConfections.StaffPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Staff Management">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F3F1F7" Margin="0">
        <StackPanel Margin="10">
            <TextBlock Text="Staff &amp; Counter Management" FontSize="18" FontWeight="Bold" Foreground="#12050C" Margin="0,0,0,15"/>

            <!-- Action & Filter Bar -->
            <Border Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="+ Add New Employee" Background="#C80208" Foreground="White" Height="38" Width="150" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,10,0" Click="AddStaff_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="Shift Schedule" Background="#F3F1F7" Foreground="Black" Height="38" Width="120" FontWeight="SemiBold" BorderThickness="1" BorderBrush="#E5E3EB">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <!-- Search Staff Box -->
                    <Border Background="#F3F1F7" CornerRadius="8" Padding="4" Height="38" Width="220" HorizontalAlignment="Right" BorderBrush="#E5E3EB" BorderThickness="1">
                        <TextBox Background="Transparent" BorderThickness="0" Text="Search staff member..." Foreground="#7E7888" VerticalContentAlignment="Center" Padding="8,0" FontSize="11"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Staff Grid Cards Container -->
            <UniformGrid Columns="2">
                <!-- Staff Card 1 -->
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,8,8">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="40" Height="40" Fill="#C80208" Margin="0,0,12,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="James Lubin" FontWeight="Bold" FontSize="13" Foreground="Black"/>
                                    <TextBlock Text="Senior Cashier • Counter 1" Foreground="#7E7888" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Background="#E8F5E9" CornerRadius="6" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="ACTIVE" Foreground="#2E7D32" FontWeight="Bold" FontSize="9"/>
                            </Border>
                        </Grid>

                        <Separator Background="#F3F1F7" Margin="0,5,0,12"/>

                        <DockPanel Margin="0,0,0,5">
                            <TextBlock Text="Email:" Foreground="#7E7888" FontSize="11"/>
                            <TextBlock Text="james.l@stylishkids.com" HorizontalAlignment="Right" FontSize="11" Foreground="Black" FontWeight="SemiBold"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,5">
                            <TextBlock Text="Today's Sales:" Foreground="#7E7888" FontSize="11"/>
                            <TextBlock Text="$1,420.50 (34 items)" HorizontalAlignment="Right" FontSize="11" Foreground="Black" FontWeight="SemiBold"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Hourly Rate:" Foreground="#7E7888" FontSize="11"/>
                            <TextBlock Text="$18.50 / hr" HorizontalAlignment="Right" FontSize="11" Foreground="Black" FontWeight="SemiBold"/>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Edit Details" Background="#F3F1F7" Foreground="Black" Height="30" Width="90" BorderThickness="1" BorderBrush="#E5E3EB" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="View Log" Background="#12050C" Foreground="White" Height="30" Width="80" BorderThickness="0" FontSize="11" FontWeight="SemiBold">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Staff Card 2 -->
                <Border Background="White" CornerRadius="12" Padding="18" Margin="8,0,0,8">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="40" Height="40" Fill="#7E7888" Margin="0,0,12,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Jessica Taylor" FontWeight="Bold" FontSize="13" Foreground="Black"/>
                                    <TextBlock Text="Cashier • Counter 2" Foreground="#7E7888" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Background="#FFF3E0" CornerRadius="6" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="OFFLINE" Foreground="#EF6C00" FontWeight="Bold" FontSize="9"/>
                            </Border>
                        </Grid>

                        <Separator Background="#F3F1F7" Margin="0,5,0,12"/>

                        <DockPanel Margin="0,0,0,5">
                            <TextBlock Text="Email:" Foreground="#7E7888" FontSize="11"/>
                            <TextBlock Text="jessica.t@stylishkids.com" HorizontalAlignment="Right" FontSize="11" Foreground="Black" FontWeight="SemiBold"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,5">
                            <TextBlock Text="Today's Sales:" Foreground="#7E7888" FontSize="11"/>
                            <TextBlock Text="$0.00 (Shift starts 4 PM)" HorizontalAlignment="Right" FontSize="11" Foreground="Black" FontWeight="SemiBold"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Hourly Rate:" Foreground="#7E7888" FontSize="11"/>
                            <TextBlock Text="$16.00 / hr" HorizontalAlignment="Right" FontSize="11" Foreground="Black" FontWeight="SemiBold"/>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Edit Details" Background="#F3F1F7" Foreground="Black" Height="30" Width="90" BorderThickness="1" BorderBrush="#E5E3EB" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="View Log" Background="#12050C" Foreground="White" Height="30" Width="80" BorderThickness="0" FontSize="11" FontWeight="SemiBold">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Staff Card 3 -->
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,8,8,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="40" Height="40" Fill="#12050C" Margin="0,0,12,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Marcus Vance" FontWeight="Bold" FontSize="13" Foreground="Black"/>
                                    <TextBlock Text="Store Manager • Admin" Foreground="#7E7888" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Background="#E8F5E9" CornerRadius="6" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="ACTIVE" Foreground="#2E7D32" FontWeight="Bold" FontSize="9"/>
                            </Border>
                        </Grid>

                        <Separator Background="#F3F1F7" Margin="0,5,0,12"/>

                        <DockPanel Margin="0,0,0,5">
                            <TextBlock Text="Email:" Foreground="#7E7888" FontSize="11"/>
                            <TextBlock Text="marcus.v@stylishkids.com" HorizontalAlignment="Right" FontSize="11" Foreground="Black" FontWeight="SemiBold"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,5">
                            <TextBlock Text="Permissions:" Foreground="#7E7888" FontSize="11"/>
                            <TextBlock Text="Full Access / Overrides" HorizontalAlignment="Right" FontSize="11" Foreground="Black" FontWeight="SemiBold"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Salary / Rate:" Foreground="#7E7888" FontSize="11"/>
                            <TextBlock Text="$2,800 / mo" HorizontalAlignment="Right" FontSize="11" Foreground="Black" FontWeight="SemiBold"/>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Edit Details" Background="#F3F1F7" Foreground="Black" Height="30" Width="90" BorderThickness="1" BorderBrush="#E5E3EB" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="View Log" Background="#12050C" Foreground="White" Height="30" Width="80" BorderThickness="0" FontSize="11" FontWeight="SemiBold">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</Page>