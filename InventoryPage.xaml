<Page x:Class="StylishkidsConfections.InventoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Inventory Management">
    <Grid Background="#F3F1F7" Margin="20">
        <StackPanel>
            <TextBlock Text="Inventory Management" FontSize="18" FontWeight="Bold" Foreground="#12050C" Margin="0,0,0,15"/>

            <!-- Add Item Action Bar -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <Button Content="+ Add New Apparel" Background="#C80208" Foreground="White" Height="38" Width="140" FontWeight="SemiBold" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <!-- Data Grid Placeholder Container -->
            <Border Background="White" CornerRadius="12" Padding="15">
                <StackPanel>
                    <TextBlock Text="Stock Item List" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                    <TextBlock Text="• Rainbow Cotton Tee (4T) — In Stock: 45 units — $14.99" Foreground="#58565D" Margin="0,0,0,8"/>
                    <TextBlock Text="• Denim Overalls (5-6Y) — In Stock: 12 units — $24.99" Foreground="#58565D" Margin="0,0,0,8"/>
                    <TextBlock Text="• Princess Party Frock — In Stock: 8 units — $32.50" Foreground="#58565D" Margin="0,0,0,8"/>
                    <TextBlock Text="• Kids Canvas Sneakers — In Stock: 30 units — $19.99" Foreground="#58565D"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>