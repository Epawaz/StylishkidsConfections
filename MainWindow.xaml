<Window x:Class="StylishkidsConfections.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stylishkids - POS &amp; Kids Clothing Terminal" 
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="#F3F1F7">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="225"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- ================= 1. FLOATING LEFT SIDEBAR (Dark Curved Panel) ================= -->
        <Border Grid.Column="0" Background="#12050C" CornerRadius="16" Margin="0,0,12,0">
            <StackPanel Margin="15,25">
                <TextBlock Text="👕 Stylishkids" Foreground="White" FontSize="17" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="Apparel POS" Foreground="#C80208" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,20"/>

                <!-- Rounded Pill Navigation Buttons -->
                <Button Content="  POS Terminal" Background="#C80208" Foreground="White" Height="38" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" BorderThickness="0" FontWeight="SemiBold" Padding="12,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="  Dashboard" Background="Transparent" Foreground="#AFAAB2" Height="38" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" BorderThickness="0" Padding="12,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="  Analysis" Background="Transparent" Foreground="#AFAAB2" Height="38" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" BorderThickness="0" Padding="12,0" Click="NavAnalysis_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="  Inventory" Background="Transparent" Foreground="#AFAAB2" Height="38" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" BorderThickness="0" Padding="12,0" Click="NavInventory_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="  Customers" Background="Transparent" Foreground="#AFAAB2" Height="38" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" BorderThickness="0" Padding="12,0" Click="NavCustomers_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="  Reports" Background="Transparent" Foreground="#AFAAB2" Height="38" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" BorderThickness="0" Padding="12,0" Click="NavReports_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="  Staff" Background="Transparent" Foreground="#AFAAB2" Height="38" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" BorderThickness="0" Padding="12,0" Click="NavStaff_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Separator Background="#2A1E24" Margin="0,12"/>

                <Button Content="  Settings" Background="Transparent" Foreground="#AFAAB2" Height="36" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" BorderThickness="0" Padding="12,0" Click="NavSettings_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="  Log Out" Background="Transparent" Foreground="#C80208" Height="36" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" BorderThickness="0" Padding="12,0" Click="LogOut_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <!-- ================= 2. CENTER CONTENT AREA ================= -->
        <Grid Grid.Column="1" Background="#F3F1F7" Margin="6,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Search Bar & Curved Action Buttons -->
            <Grid Grid.Row="0" Margin="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Curved Search Box -->
                    <Border Background="White" CornerRadius="8" Padding="4" Height="40" Width="280" BorderBrush="#E5E3EB" BorderThickness="1">
                        <TextBox Background="Transparent" BorderThickness="0" Text="Search apparel, sizes, items..." Foreground="#7E7888" VerticalContentAlignment="Center" Padding="8,0"/>
                    </Border>

                    <!-- Curved Scan Barcode Button -->
                    <Button Content="Scan Barcode" Background="#C80208" Foreground="White" Height="40" Width="105" Margin="10,0,0,0" BorderThickness="0" FontWeight="SemiBold" Click="ScanBarcode_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Curved Quick Bill Button -->
                    <Button Content="Quick Bill" Background="White" Foreground="Black" BorderBrush="#E5E3EB" BorderThickness="1" Height="40" Width="90" Margin="8,0,0,0" FontWeight="SemiBold" Click="QuickBill_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Dynamic Workspace Frame -->
            <Frame x:Name="MainContentFrame" Grid.Row="1" NavigationUIVisibility="Hidden">
                <Frame.Content>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,0,10,10">
                        <StackPanel>
                            <!-- Category Selector Strip -->
                            <Border Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="Clothing Categories" FontSize="14" FontWeight="Bold" Foreground="Black" Margin="0,0,0,10"/>
                                    <WrapPanel>
                                        <Button Content="All Items" Background="#12050C" Foreground="White" Height="32" Padding="12,0" Margin="0,0,8,0" BorderThickness="0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        <Button Content="Toddler Wear" Background="#F3F1F7" Foreground="Black" Height="32" Padding="12,0" Margin="0,0,8,0" BorderThickness="1" BorderBrush="#E5E3EB">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        <Button Content="Party Dresses" Background="#F3F1F7" Foreground="Black" Height="32" Padding="12,0" Margin="0,0,8,0" BorderThickness="1" BorderBrush="#E5E3EB">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        <Button Content="Boys Tees &amp; Jeans" Background="#F3F1F7" Foreground="Black" Height="32" Padding="12,0" Margin="0,0,8,0" BorderThickness="1" BorderBrush="#E5E3EB">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        <Button Content="Footwear" Background="#F3F1F7" Foreground="Black" Height="32" Padding="12,0" BorderThickness="1" BorderBrush="#E5E3EB">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Product Items Grid -->
                            <Border Background="White" CornerRadius="12" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Popular Kids Apparel >" FontWeight="SemiBold" Foreground="Black" Margin="0,0,0,12"/>

                                    <UniformGrid Columns="4">
                                        <!-- Item 1 -->
                                        <Border Background="#F3F1F7" CornerRadius="8" Padding="10" Margin="6" Cursor="Hand" MouseLeftButtonDown="ProductCard_Click">
                                            <StackPanel>
                                                <Rectangle Height="85" Fill="#EAE6EE" RadiusX="6" RadiusY="6"/>
                                                <TextBlock Text="Rainbow Cotton Tee (4T)" FontSize="11" FontWeight="SemiBold" Foreground="Black" Margin="0,6,0,2" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="$14.99" FontSize="12" Foreground="#C80208" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Item 2 -->
                                        <Border Background="#F3F1F7" CornerRadius="8" Padding="10" Margin="6" Cursor="Hand">
                                            <StackPanel>
                                                <Rectangle Height="85" Fill="#EAE6EE" RadiusX="6" RadiusY="6"/>
                                                <TextBlock Text="Denim Overalls (5-6Y)" FontSize="11" FontWeight="SemiBold" Foreground="Black" Margin="0,6,0,2" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="$24.99" FontSize="12" Foreground="#C80208" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Item 3 -->
                                        <Border Background="#F3F1F7" CornerRadius="8" Padding="10" Margin="6" Cursor="Hand">
                                            <StackPanel>
                                                <Rectangle Height="85" Fill="#EAE6EE" RadiusX="6" RadiusY="6"/>
                                                <TextBlock Text="Princess Party Frock" FontSize="11" FontWeight="SemiBold" Foreground="Black" Margin="0,6,0,2" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="$32.50" FontSize="12" Foreground="#C80208" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Item 4 -->
                                        <Border Background="#F3F1F7" CornerRadius="8" Padding="10" Margin="6" Cursor="Hand">
                                            <StackPanel>
                                                <Rectangle Height="85" Fill="#EAE6EE" RadiusX="6" RadiusY="6"/>
                                                <TextBlock Text="Kids Canvas Sneakers" FontSize="11" FontWeight="SemiBold" Foreground="Black" Margin="0,6,0,2" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="$19.99" FontSize="12" Foreground="#C80208" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Frame.Content>
            </Frame>
        </Grid>

        <!-- ================= 3. RIGHT SIDEBAR (Floating Curved Cart Panel) ================= -->
        <Border Grid.Column="2" Background="White" CornerRadius="16" Margin="12,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="75"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>

                <!-- User Badge -->
                <Grid Grid.Row="0" Margin="15,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="36" Height="36" Fill="#C80208" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="James Lubin" FontWeight="Bold" FontSize="13" Foreground="Black"/>
                            <TextBlock Text="Counter 1 Terminal" Foreground="#7E7888" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Cart Items Scrollable List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="15,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Current Order Cart" FontWeight="Bold" FontSize="14" Foreground="Black"/>
                            <TextBlock Text="Clear 🗑️" HorizontalAlignment="Right" Foreground="#C80208" FontSize="12" Cursor="Hand"/>
                        </Grid>

                        <!-- Cart Item 1 -->
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="40" Height="40" Fill="#EAE6EE" RadiusX="6" RadiusY="6" Margin="0,0,10,0"/>
                                <StackPanel VerticalAlignment="Center" Width="130">
                                    <TextBlock Text="Rainbow Cotton Tee (4T)" FontWeight="SemiBold" FontSize="11" Foreground="Black" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Size: 4T • Pink" Foreground="#7E7888" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="$14.99" FontWeight="Bold" FontSize="11" Foreground="Black" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text=" -  1  + " Foreground="#7E7888" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Cart Item 2 -->
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="40" Height="40" Fill="#EAE6EE" RadiusX="6" RadiusY="6" Margin="0,0,10,0"/>
                                <StackPanel VerticalAlignment="Center" Width="130">
                                    <TextBlock Text="Denim Overalls (5-6Y)" FontWeight="SemiBold" FontSize="11" Foreground="Black" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Size: 5Y • Blue" Foreground="#7E7888" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="$24.99" FontWeight="Bold" FontSize="11" Foreground="Black" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text=" -  1  + " Foreground="#7E7888" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Checkout Billing Summary & Action Button -->
                <Border Grid.Row="2" Background="#F9F8FB" CornerRadius="0,0,16,16" Padding="15" BorderBrush="#EFEFEF" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Subtotal" Foreground="#7E7888" FontSize="11"/>
                            <TextBlock Text="$39.98" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11" Foreground="Black"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Discount (VIP)" Foreground="#7E7888" FontSize="11"/>
                            <TextBlock Text="-$4.00" HorizontalAlignment="Right" Foreground="#C80208" FontSize="11"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Tax (5%)" Foreground="#7E7888" FontSize="11"/>
                            <TextBlock Text="$1.80" HorizontalAlignment="Right" FontSize="11" Foreground="Black"/>
                        </DockPanel>
                        <Separator Background="#E0E0E0" Margin="0,0,0,8"/>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Total Due" FontWeight="Bold" FontSize="13" Foreground="Black"/>
                            <TextBlock Text="$37.78" HorizontalAlignment="Right" FontWeight="Bold" FontSize="15" Foreground="Black"/>
                        </DockPanel>

                        <!-- Complete Sale Button -->
                        <Button Content="💳 Complete Purchase" Background="#C80208" Foreground="White" Height="42" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="CompletePurchase_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>