<Window x:Class="StylishkidsConfections.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stylishkids Confections - Login" Height="550" Width="850"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT BRAND PANEL (Solid Black Theme) ================= -->
        <Grid Grid.Column="0" Background="#12050C">
            <StackPanel VerticalAlignment="Center" Margin="30">
                <TextBlock Text="👕 Stylishkids" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="Apparel POS" Foreground="#C80208" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                <TextBlock Text="Children's clothing, apparel retail, and store management tailored for modern retail experiences." Foreground="#AFAAB2" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
            </StackPanel>
        </Grid>

        <!-- ================= RIGHT LOGIN FORM PANEL ================= -->
        <Grid Grid.Column="1" Background="#FBF8FB">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">

                <!-- Header -->
                <TextBlock Text="Welcome Back!" FontSize="22" FontWeight="Bold" Foreground="#12050C" Margin="0,0,0,5"/>
                <TextBlock Text="Sign in to access your apparel counter" FontSize="12" Foreground="#7E7888" Margin="0,0,0,25"/>

                <!-- Username / Email Field -->
                <TextBlock Text="Staff Email or ID" FontSize="11" FontWeight="SemiBold" Foreground="#58565D" Margin="0,0,0,5"/>
                <Border Background="White" CornerRadius="8" Height="40" BorderBrush="#E5E3EB" BorderThickness="1" Margin="0,0,0,15">
                    <TextBox x:Name="txtUsername" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0" Foreground="#12050C" FontSize="12" Text="counter1@stylishkids.com"/>
                </Border>

                <!-- Password Field -->
                <TextBlock Text="Password" FontSize="11" FontWeight="SemiBold" Foreground="#58565D" Margin="0,0,0,5"/>
                <Border Background="White" CornerRadius="8" Height="40" BorderBrush="#E5E3EB" BorderThickness="1" Margin="0,0,0,20">
                    <PasswordBox x:Name="txtPassword" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0" Foreground="#12050C" Password="sweetpassword123"/>
                </Border>

                <!-- Curved Red Login Button -->
                <Button x:Name="btnLogin" Content="Open Terminal" Background="#C80208" Foreground="White" Height="42" FontWeight="Bold" FontSize="13" BorderThickness="0" Click="BtnLogin_Click" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Close Option -->
                <TextBlock Text="✕ Close Application" Foreground="#7E7888" FontSize="11" HorizontalAlignment="Center" Margin="0,20,0,0" Cursor="Hand" MouseLeftButtonDown="CloseText_MouseLeftButtonDown"/>

            </StackPanel>
        </Grid>
    </Grid>
</Window>