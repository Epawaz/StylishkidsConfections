<Window x:Class="StylishkidsConfections.QuickBillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Bill Item" Height="340" Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent">

    <!-- Rounded Outer Container -->
    <Border Background="White" CornerRadius="16" Padding="25" BorderBrush="#E5E3EB" BorderThickness="1">
        <StackPanel VerticalAlignment="Center">

            <!-- Header -->
            <TextBlock Text="⚡ Quick Bill Custom Item" FontSize="16" FontWeight="Bold" Foreground="Black" Margin="0,0,0,5"/>
            <TextBlock Text="Enter custom item details for immediate checkout" FontSize="11" Foreground="#7E7888" Margin="0,0,0,20"/>

            <!-- Item Description Input -->
            <TextBlock Text="Item Description / Size" FontSize="11" FontWeight="SemiBold" Foreground="#58565D" Margin="0,0,0,5"/>
            <Border Background="#F3F1F7" CornerRadius="8" Height="40" Padding="10,0" Margin="0,0,0,15">
                <TextBox x:Name="txtItemName" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Text="Custom Apparel Item" FontSize="12" Foreground="Black"/>
            </Border>

            <!-- Price Input -->
            <TextBlock Text="Price ($)" FontSize="11" FontWeight="SemiBold" Foreground="#58565D" Margin="0,0,0,5"/>
            <Border Background="#F3F1F7" CornerRadius="8" Height="40" Padding="10,0" Margin="0,0,0,20">
                <TextBox x:Name="txtItemPrice" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Text="15.00" FontSize="12" Foreground="Black"/>
            </Border>

            <!-- Action Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Cancel" Background="#F3F1F7" Foreground="Black" Height="40" FontWeight="SemiBold" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand" Click="Cancel_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="1" Content="Add to Cart" Background="#C80208" Foreground="White" Height="40" FontWeight="SemiBold" Margin="6,0,0,0" BorderThickness="0" Cursor="Hand" Click="Add_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

        </StackPanel>
    </Border>
</Window>