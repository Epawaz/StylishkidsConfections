<Page
 x:Class="StylishkidsConfections.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F3F1F7" Margin="0">
        <StackPanel Margin="10">
            <TextBlock Text="Terminal &amp; Store Settings" FontSize="18" FontWeight="Bold" Foreground="#12050C" Margin="0,0,0,15"/>

            <UniformGrid Columns="2">

                <!-- Card 1: Store Profile -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,8,12">
                    <StackPanel>
                        <TextBlock Text="Store &amp; Receipt Profile" FontWeight="Bold" FontSize="14" Foreground="#12050C" Margin="0,0,0,15"/>

                        <TextBlock Text="Store Name" FontSize="11" FontWeight="SemiBold" Foreground="#58565D" Margin="0,0,0,5"/>
                        <Border Background="#F3F1F7" CornerRadius="8" Height="38" Padding="10,0" Margin="0,0,0,12" BorderBrush="#E5E3EB" BorderThickness="1">
                            <TextBox Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Text="Stylishkids Apparel Boutique" FontSize="11" Foreground="Black"/>
                        </Border>

                        <TextBlock Text="Receipt Footer Message" FontSize="11" FontWeight="SemiBold" Foreground="#58565D" Margin="0,0,0,5"/>
                        <Border Background="#F3F1F7" CornerRadius="8" Height="38" Padding="10,0" Margin="0,0,0,15" BorderBrush="#E5E3EB" BorderThickness="1">
                            <TextBox Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Text="Thank you for shopping with us! No returns after 14 days." FontSize="11" Foreground="Black"/>
                        </Border>

                        <Button Content="Save Profile" Background="#12050C" Foreground="White" Height="36" Width="110" HorizontalAlignment="Left" FontWeight="SemiBold" BorderThickness="0" Click="Save_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Card 2: Tax & POS Preferences -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="8,0,0,12">
                    <StackPanel>
                        <TextBlock Text="POS &amp; Tax Configuration" FontWeight="Bold" FontSize="14" Foreground="#12050C" Margin="0,0,0,15"/>

                        <TextBlock Text="Sales Tax Rate (%)" FontSize="11" FontWeight="SemiBold" Foreground="#58565D" Margin="0,0,0,5"/>
                        <Border Background="#F3F1F7" CornerRadius="8" Height="38" Padding="10,0" Margin="0,0,0,12" BorderBrush="#E5E3EB" BorderThickness="1">
                            <TextBox Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Text="5.0" FontSize="11" Foreground="Black"/>
                        </Border>

                        <TextBlock Text="Default Counter ID" FontSize="11" FontWeight="SemiBold" Foreground="#58565D" Margin="0,0,0,5"/>
                        <Border Background="#F3F1F7" CornerRadius="8" Height="38" Padding="10,0" Margin="0,0,0,15" BorderBrush="#E5E3EB" BorderThickness="1">
                            <TextBox Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Text="Counter 1 Terminal" FontSize="11" Foreground="Black"/>
                        </Border>

                        <Button Content="Update Settings" Background="#C80208" Foreground="White" Height="36" Width="120" HorizontalAlignment="Left" FontWeight="SemiBold" BorderThickness="0" Click="Save_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Card 3: Hardware Peripherals -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Hardware &amp; Peripherals" FontWeight="Bold" FontSize="14" Foreground="#12050C" Margin="0,0,0,15"/>
                        <TextBlock Text="• Barcode Scanner: Connected (USB Port COM3)" Foreground="#2E7D32" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,8"/>
                        <TextBlock Text="• Thermal Receipt Printer: Ready (EPSON TM-T20II)" Foreground="#2E7D32" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,15"/>

                        <Button Content="Test Printer Connection" Background="#F3F1F7" Foreground="Black" Height="36" Width="165" HorizontalAlignment="Left" FontWeight="SemiBold" BorderThickness="1" BorderBrush="#E5E3EB">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Card 4: System & Database Management -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="System Database" FontWeight="Bold" FontSize="14" Foreground="#12050C" Margin="0,0,0,15"/>
                        <TextBlock Text="Local SQLite inventory database is synced and operating normally." Foreground="#58565D" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,15"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Backup Data" Background="#F3F1F7" Foreground="Black" Height="36" Width="110" FontWeight="SemiBold" BorderThickness="1" BorderBrush="#E5E3EB" Margin="0,0,8,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="Clear Cache" Background="#F3F1F7" Foreground="Black" Height="36" Width="110" FontWeight="SemiBold" BorderThickness="1" BorderBrush="#E5E3EB">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 5: System & App Updates -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,12,8,0">
                    <StackPanel>
                        <TextBlock Text="Software Updates" FontWeight="Bold" FontSize="14" Foreground="#12050C" Margin="0,0,0,5"/>
                        <TextBlock Text="Current Version: v1.2.0-stable" Foreground="#7E7888" FontSize="11" Margin="0,0,0,15"/>

                        <Button Content="Check for Updates" Background="#C80208" Foreground="White" Height="36" Width="145" HorizontalAlignment="Left" FontWeight="SemiBold" BorderThickness="0" Click="CheckUpdates_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</Page>